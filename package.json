{
  "name": "preferred-tools",
  "version": "0.1.3",
  "private": true,
  "description": "Build and test scripts for the preferred-tools Claude Code plugin. The plugin has no runtime dependencies.",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "test": "node --test tests/*.test.js",
    "matrix": "node --test --test-concurrency=1 tests/matrix/*.test.js",
