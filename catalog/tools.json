{
  "schema": 1,
  "note": "The 17 rows of preferred-tools. Facts are checked against the vendor docs in docs/sources.md (read 2026-10-27). Placeholders: {root} location root, {name} registration name, {host}, {value}. No secret in this file: a token is only ever a ${VAR} reference.",
  "rules": {
    "ageGateDays": 7,
    "cutoff": "2026-10-20T23:59:59Z",
    "windowsArmPython": "cpython-{minor}-windows-x86_64-none",
    "windowsNpxCmd": {
      "documented": false,
      "source": "docs/sources.md, \"Windows cmd /c for npx\""
    },
    "nameRe": "^[A-Za-z0-9_-]{1,64}$"
  },
  "groups": [
    {
      "id": "code",
      "label": "Code"
    },
    {
      "id": "docs",
      "label": "Docs and forges"
    },
    {
      "id": "browsers",
      "label": "Browsers"
    },
    {
      "id": "machine",
      "label": "Machine and monitoring"
    }
  ],
  "tools": [
    {
      "id": "serena",
      "kind": "mcp",
      "group": "code",
      "label": "serena",
      "summary": "code navigation: symbols, references, reference-aware rename and delete",
      "name": "serena",
      "os": [
        "darwin",
        "linux",
        "win32"
      ],
      "recommendedRoute": "local",
      "routes": {
        "local": {
          "runtime": "uvx",
          "python": "3.13",
          "with": [],
          "projectScope": false,
          "package": {
            "registry": "pypi",
            "name": "serena-agent",
            "version": "2.1.0",
            "fromSpec": "serena-agent@{version}",
            "cutoff": "2026-10-20T23:59:59Z"
          },
          "run": [
            "serena",
            "start-mcp-server",
            "--context",
            "claude-code",
            "--enable-web-dashboard",
            "false",
            "--project-from-cwd",
            "--agent-interface",
            "tools"
          ],
          "env": {
            "SERENA_USAGE_REPORTING": "false"
          },
          "fingerprints": [
            {
              "pkg": "serena-agent"
            }
          ],
          "prereqs": [
            "uvx"
          ]
        }
      },
      "locations": {
        "defaultSide": "project",
        "alfred": ".alfred/serena/home",
        "windowsAbsolute": true,
        "derived": [
          {
            "in": "env",
            "key": "SERENA_HOME",
            "sub": ""
          }
        ]
      },
      "dangerous": []
    },
    {
      "id": "memory",
      "kind": "mcp",
      "group": "code",
      "label": "memory",
      "summary": "persistent memory (sqlite-vec) shared across projects",
      "name": "memory",
      "os": [
        "darwin",
        "linux",
        "win32"
      ],
      "recommendedRoute": "local",
      "routes": {
        "local": {
          "runtime": "uvx",
          "python": "3.13",
          "with": [],
          "projectScope": false,
          "package": {
            "registry": "pypi",
            "name": "mcp-memory-service",
            "version": "12.1.1",
            "fromSpec": "mcp-memory-service[sqlite]=={version}",
            "cutoff": "2026-10-20T23:59:59Z"
          },
          "run": [
            "memory",
            "server"
          ],
          "env": {
            "MCP_MEMORY_STORAGE_BACKEND": "sqlite_vec",
            "MCP_MEMORY_SQLITE_PRAGMAS": "busy_timeout=15000"
          },
          "fingerprints": [
            {
              "pkg": "mcp-memory-service"
            }
          ],
          "prereqs": [
            "uvx"
          ]
        }
      },
      "locations": {
        "defaultSide": "account",
        "alfred": "~/.alfred-memory",
        "derived": [
          {
            "in": "env",
            "key": "MCP_MEMORY_SQLITE_PATH",
            "sub": "memory.db"
          }
        ]
      },
      "dangerous": []
    },
