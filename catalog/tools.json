      "id": "github",
      "kind": "mcp",
      "group": "docs",
      "label": "github",
      "summary": "GitHub repositories, issues, pull requests (hosted, or the vendor Docker image)",
      "name": "github",
      "os": [
        "darwin",
        "linux",
        "win32"
      ],
      "recommendedRoute": "remote",
      "routes": {
        "remote": {
          "projectScope": true,
          "type": "http",
          "url": "https://api.githubcopilot.com/mcp/",
          "auth": "token",
          "tokenVar": "GITHUB_PERSONAL_ACCESS_TOKEN",
          "headers": {
            "Authorization": "Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}"
          },
          "fingerprints": [
            {
              "host": "api.githubcopilot.com",
              "pathPrefix": "/mcp"
            }
          ],
          "prereqs": []
        },
        "local": {
          "projectScope": false,
          "runtime": "docker",
          "auth": "token",
          "tokenVar": "GITHUB_PERSONAL_ACCESS_TOKEN",
          "image": {
            "name": "ghcr.io/github/github-mcp-server",
            "tag": "v2.0.2"
          },
          "run": [
            "stdio"
          ],
          "env": {
            "GITHUB_PERSONAL_ACCESS_TOKEN": "${GITHUB_PERSONAL_ACCESS_TOKEN}"
          },
          "fallback": {
            "runtime": "binary",
            "command": "github-mcp-server",
            "args": [
              "stdio"
            ],
            "when": "no-docker"
          },
          "fingerprints": [
            {
              "pkg": "ghcr.io/github/github-mcp-server"
            },
            {
              "command": "github-mcp-server"
            }
